# Wazuh MCP Server configuration
# Copy to .env and edit. Full reference: docs/configuration.md
#
# docker compose passes this file to the container (env_file) and, inside it, overrides
# MCP_HOST, MCP_PORT and ENVIRONMENT with 0.0.0.0, 3000 and production.
# The server does not read .env by itself: when running from source, export the
# variables first (set -a; . ./.env; set +a).
# After editing, apply changes with `docker compose up -d` (a restart keeps the old values).

# === Wazuh Manager (required; startup fails if any of the three is empty) ===
# Hostname or IP; an http(s):// prefix is stripped. The Manager API is always HTTPS.
WAZUH_HOST=your-wazuh-manager.example.com
WAZUH_USER=your-api-user
WAZUH_PASS=your-api-password
WAZUH_PORT=55000

# Manager TLS is verified by default. The stock Wazuh API certificate (CN=wazuh.com, no
# subjectAltName) cannot pass: reissue it with a subjectAltName for WAZUH_HOST and set
# WAZUH_CA_BUNDLE to its CA, or set WAZUH_ALLOW_SELF_SIGNED=true to skip verification.
# WAZUH_CA_BUNDLE is also used for the Indexer and must exist at startup.
# See docs/configuration.md#manager-tls.
# WAZUH_CA_BUNDLE=/app/certs/ca.pem
# WAZUH_ALLOW_SELF_SIGNED=false
# WAZUH_VERIFY_SSL=true

# Manager/Indexer request timeout in seconds (1-300) and concurrent Manager requests (1-100)
# REQUEST_TIMEOUT_SECONDS=30
# MAX_CONNECTIONS=10
# Largest `limit` accepted by get_wazuh_alerts and search_security_events (1-10000)
# MAX_ALERTS_PER_QUERY=1000

# === Wazuh Indexer (required for alert, vulnerability and alert-backed compliance tools) ===
# WAZUH_INDEXER_HOST=your-wazuh-indexer.example.com
# WAZUH_INDEXER_PORT=9200
# WAZUH_INDEXER_USER=your-indexer-user
# WAZUH_INDEXER_PASS=your-indexer-password
# HTTPS by default; set false (or prefix the host with http://) for a plain-HTTP node.
# WAZUH_INDEXER_SSL=true
# Stock Indexer certificates are signed by wazuh-certs-tool's root-ca.pem: add it to
# WAZUH_CA_BUNDLE, or set false to skip verification.
# WAZUH_INDEXER_VERIFY_SSL=true

# === Deployment environment ===
# development (default when running from source) or production (Docker image and compose default).
# Production requires AUTH_SECRET_KEY unless AUTH_MODE=none, and turns on
# WAZUH_REQUIRE_ACTION_CONFIRMATION unless it is set explicitly.
ENVIRONMENT=development

# === Listener (overridden to 0.0.0.0:3000 inside the compose container) ===
MCP_HOST=127.0.0.1
MCP_PORT=3000
# Compose only: host interface the port is published on (loopback expects a reverse proxy).
# MCP_BIND=127.0.0.1

# === Authentication ===
# bearer (default), oauth, or none (authless)
AUTH_MODE=bearer

# Token signing key. Required in production (at least 32 characters, not a placeholder);
# use the same value on every instance. Generate with: openssl rand -hex 32
# Left unset so an unedited copy fails fast in production instead of using a public value.
# Outside production a random per-process key is generated.
# AUTH_SECRET_KEY=

# Lifetime of JWTs from POST /auth/token, in hours (1-8760)
TOKEN_LIFETIME_HOURS=24

# Single API key: "wazuh_" + 43 characters. Generate with:
#   python -c "import secrets; print('wazuh_' + secrets.token_urlsafe(32))"
# Clients exchange it at POST /auth/token for a bearer JWT, or use it to sign in on
# /oauth/authorize in OAuth mode without an identity provider. If unset, a per-process key
# is generated: printed to stderr in development (bearer mode), never shown in production.
# Changing it invalidates its tokens.
# MCP_API_KEY=
# Scopes for MCP_API_KEY: read-only by default; use "wazuh:read wazuh:write" (quoted)
# for keys that may run active response. Quote any value that contains spaces or JSON.
# MCP_API_KEY_SCOPES=wazuh:read

# Multiple keys (ignored when a valid MCP_API_KEY is set). key_hash is the hex
# HMAC-SHA256 of the key using AUTH_SECRET_KEY; see docs/configuration.md.
# API_KEYS='[{"id":"alice","name":"Alice","key_hash":"<hex>","created_at":"2026-09-01T00:00:00Z","scopes":["wazuh:read"]}]'

# Authless mode only (AUTH_MODE=none): grant write tools to unauthenticated callers.
# AUTHLESS_ALLOW_WRITE=false

# === OAuth 2.0 (AUTH_MODE=oauth only) ===
# Public base URL of this server; derived from the request if unset (warning in production).
# OAUTH_ISSUER_URL=https://mcp.example.com
# Dynamic Client Registration at POST /oauth/register (unauthenticated when enabled).
# OAUTH_ENABLE_DCR=false
# Token and code lifetimes in seconds
# OAUTH_ACCESS_TOKEN_TTL=3600
# OAUTH_REFRESH_TOKEN_TTL=86400
# OAUTH_AUTHORIZATION_CODE_TTL=600

# --- OpenID Connect identity provider (optional) ---
# Users sign in at the provider instead of pasting an API key on /oauth/authorize.
# Register <OAUTH_ISSUER_URL>/oauth/callback as the redirect URI at the provider.
# Checked at startup whenever OAUTH_IDP_ISSUER is set. See docs/configuration.md.
# Issuer URL (https:// only). Leave the client secret empty for a public client with PKCE.
# OAUTH_IDP_ISSUER=https://login.microsoftonline.com/your-tenant-id/v2.0
# OAUTH_IDP_CLIENT_ID=
# OAUTH_IDP_CLIENT_SECRET=
# OAUTH_IDP_SCOPES="openid email profile"
# Allow-lists (comma-separated). Multi-tenant Entra issuers need OAUTH_IDP_ALLOWED_TENANTS;
# https://accounts.google.com needs OAUTH_IDP_ALLOWED_DOMAINS or OAUTH_IDP_ALLOWED_USERS.
# OAUTH_IDP_ALLOWED_TENANTS=
# OAUTH_IDP_ALLOWED_DOMAINS=corp.example.com
# OAUTH_IDP_ALLOWED_USERS=
# Claim holding group names ("roles" for Entra app roles) and a JSON group-to-scope map.
# Users in no mapped group get OAUTH_IDP_DEFAULT_SCOPE; an empty default denies them.
# OAUTH_IDP_GROUP_CLAIM=groups
# OAUTH_IDP_GROUP_SCOPE_MAP='{"soc-admins": "wazuh:read wazuh:write", "soc-analysts": "wazuh:read"}'
# OAUTH_IDP_DEFAULT_SCOPE=wazuh:read
# Claim used as the audited identity (falls back to preferred_username, then sub).
# OAUTH_IDP_SUBJECT_CLAIM=email
# Seconds a sign-in may take at the provider (1-3600)
# OAUTH_IDP_LOGIN_TTL=600

# === CORS / Origin ===
# Exact-match origins (no wildcards). Requests with an Origin header not listed get 403.
ALLOWED_ORIGINS=https://claude.ai,http://localhost:3000

# === Reverse proxy and rate limiting ===
# Proxy IPs trusted for X-Forwarded-For / X-Real-IP.
# TRUSTED_PROXIES=10.0.0.1
# Sliding-window limit: per principal + client IP on /mcp and /, per IP on other routes.
# RATE_LIMIT_REQUESTS=100
# RATE_LIMIT_WINDOW=60

# === Sessions (legacy initialize-based clients) ===
# Shared session store for multiple instances; in-memory when unset.
# REDIS_URL=redis://redis:6379/0
# Redis key TTL in seconds (read only with REDIS_URL; sessions also expire after 30 min idle).
# SESSION_TTL_SECONDS=1800
# In-memory session caps (total, and per principal); not applied with REDIS_URL.
# MAX_SESSIONS=1000
# MAX_SESSIONS_PER_PRINCIPAL=100

# === Logging and resources ===
LOG_LEVEL=INFO
# LOG_FORMAT=json
# Above this RSS (MiB, minimum 64) non-probe requests get 503 "Server overloaded".
# MAX_MEMORY_MB=512

# === Tool exposure and output ===
# Toolsets: alerts, agents, vulnerabilities, analysis, web_search, compliance, system, response (default: all)
# WAZUH_TOOLSETS=alerts,agents,vulnerabilities,analysis,compliance,system
# WAZUH_DISABLED_TOOLS=wazuh_restart,wazuh_active_response
# Longest tool result in characters; longer results are truncated with a note.
# MAX_TOOL_RESPONSE_CHARS=1000000
# json (default) or gcf (Graph Compact Format: fewer tokens, lossless)
# RESPONSE_FORMAT=json

# === Active-response safety ===
# IPs/CIDRs the block tools refuse to block (loopback and an IP WAZUH_HOST are always protected).
# WAZUH_PROTECTED_IPS=10.0.0.1,192.168.1.0/24
# Require confirm=true on every write tool. Default: true when ENVIRONMENT=production, else false.
# WAZUH_REQUIRE_ACTION_CONFIRMATION=true
# Allow host-level actions and restarts aimed at agent 000 (the Manager).
# WAZUH_ALLOW_MANAGER_AR=false
# Allow wazuh_block_ip with all_agents=true.
# WAZUH_ALLOW_FLEET_AR=false
# Extra directories wazuh_quarantine_file refuses (added to the built-in system list),
# and an optional allow-list of the only directories it accepts.
# WAZUH_QUARANTINE_DENY_PREFIXES=/srv/critical
# WAZUH_QUARANTINE_ALLOW_PREFIXES=/home,/tmp
# Operator-deployed undo commands; wazuh_firewall_allow / wazuh_host_allow refuse without them.
# WAZUH_AR_FIREWALL_UNDO_COMMAND=!firewall-undrop
# WAZUH_AR_HOSTDENY_UNDO_COMMAND=!host-undeny

# === Optional integrations ===
# Multi-cluster file (single cluster when the file does not exist).
# WAZUH_CLUSTERS_FILE=./config/clusters.json
# You.com web search for search_external_context (sends queries off-box).
# YDC_API_KEY=
# YDC_BASE_URL=https://ydc-index.io
# YDC_VERIFY_SSL=true

# === Local LLM stack (compose.local-llm.yml only; see docs/LOCAL_LLM.md) ===
# VLLM_API_KEY=
# WEBUI_SECRET_KEY=
